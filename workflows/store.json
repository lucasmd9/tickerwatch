    {
      "parameters": {
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $json.cfg.spreadsheet_id + '/values:batchGet?' + \"ranges=Universe%21A%3AM&ranges=Events%21A%3AB&ranges=ImpactLinks%21A%3AB&ranges=Earnings%21A%3AB&ranges=Runs%21A%3AB&ranges=Briefings%21A%3AB&ranges=Meta%21A%3AB\" }}",
