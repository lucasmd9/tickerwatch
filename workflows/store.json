        "options": {
          "timeout": 45000
        }
      },
      "id": "f7fb8a8b-57b7-59b5-935b-807de0ecf3e4",
      "name": "Read database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const c=JSON.parse(JSON.stringify($('Input').first().json));\nconst r=$input.first().json;\nif(!Array.isArray(r.valueRanges)) throw new Error('Sheets did not return database ranges. Check credential and spreadsheet ID.');\nc.state={};c.rows={};c.nextRows={};c.dirty=[];\nconst names=['Universe','Events','ImpactLinks','Earnings','Runs','Briefings','Meta'];\nfor(let i=0;i<names.length;i++){\n const name=names[i],v=r.valueRanges[i]?.values||[];\n if(!v.length)throw new Error('Missing headers in '+name+'. Run Setup Database once.');\n if(name==='Universe'){\n  const h=v[0];c.universe=v.slice(1).filter(a=>a[0]).map(a=>Object.fromEntries(h.map((k,j)=>[k,String(a[j]??'').trim()])));\n  const ids=new Set();for(const s of c.universe){if(!s.stock_id||!s.issuer_id||!s.ticker||!s.exchange||!s.yahoo_symbol||!s.company)throw new Error('Incomplete Universe row '+s.stock_id);if(ids.has(s.stock_id))throw new Error('Duplicate stock_id '+s.stock_id);ids.add(s.stock_id);}\n }else{\n  c.state[name]={};c.rows[name]={};c.nextRows[name]=v.length+1;\n  for(let j=1;j<v.length;j++){const [k,raw]=v[j];if(!k)continue;try{c.state[name][k]=JSON.parse(raw);}catch{throw new Error('Invalid stored JSON: '+name+' row '+(j+1));}c.rows[name][k]=j+1;}\n }\n}\nreturn [{json:c}];\n"
      },
      "id": "18c1cc33-4069-59fe-b4df-ee42b5041147",
      "name": "Decode database",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const c=JSON.parse(JSON.stringify($('Input').first().json));const data=[];\nconst unique=new Map();for(const x of c.dirty||[])unique.set(x.table+'|'+x.key,x);\nfor(const x of unique.values()){\n if(!['Events','ImpactLinks','Earnings','Runs','Briefings','Meta'].includes(x.table))throw new Error('Invalid table');\n if(!c.rows?.[x.table]||!c.nextRows?.[x.table])throw new Error('Write needs a loaded database context');\n const persisted=JSON.parse(JSON.stringify(x.value));if(x.table==='Events'&&persisted.candidates)persisted.candidates=persisted.candidates.map(m=>({stock_id:m.stock_id,match_type:m.match_type,matched:m.matched}));const text=JSON.stringify(persisted);if(text.length>45000)throw new Error('Record exceeds safe Sheets cell size: '+x.table+'/'+x.key);\n let row=c.rows[x.table][x.key];if(!row){row=c.nextRows[x.table]++;c.rows[x.table][x.key]=row;}\n if(row>10000)throw new Error('Database tab capacity reached; expand sheet rows and update configured limit.');c.state[x.table][x.key]=x.value;\n data.push({range:`${x.table}!A${row}:B${row}`,values:[[x.key,text]]});\n}\nc.dirty=[];return [{json:{...c,body:{valueInputOption:'RAW',data}}}];\n"
      },
